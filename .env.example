# GRAPES Hub Configuration
# Copy this file to .env and update with your values
# NEVER commit .env to version control

# ============================================
# Container Image Settings
# ============================================
IMAGE_REGISTRY=ghcr.io
IMAGE_OWNER=tbowman01
IMAGE_NAME=grapes/automation-runner
IMAGE_TAG=latest

# ============================================
# Documentation Site
# ============================================
DOCS_BASE_URL=/grapes
DOCS_TITLE=GRAPES Hub
DOCS_URL=https://tbowman01.github.io

# ============================================
# Evaluation Configuration
# ============================================
# Provider options: ollama, openai, anthropic, azure, bedrock
EVAL_MODEL_PROVIDER=ollama
EVAL_MODEL=llama3.1:8b
EVAL_TIMEOUT_MS=60000
EVAL_MAX_CONCURRENCY=5

# Ollama specific (if using)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI specific (if using)
# OPENAI_API_KEY=sk-...

# Anthropic specific (if using)
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# GitHub Configuration
# ============================================
# GITHUB_TOKEN is automatically provided in GitHub Actions
# For local development with gh CLI, it uses your authenticated session

# ============================================
# Node.js Version
# ============================================
NODE_VERSION=22

# ============================================
# Security & Scanning
# ============================================
TRIVY_SEVERITY=CRITICAL,HIGH
SBOM_FORMAT=cyclonedx-json
